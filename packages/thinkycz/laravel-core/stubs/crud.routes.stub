use App\Http\Controllers\Api\{{ model }}\{{ model }}IndexController;
use App\Http\Controllers\Api\{{ model }}\{{ model }}ShowController;
use App\Http\Controllers\Api\{{ model }}\{{ model }}StoreController;
use App\Http\Controllers\Api\{{ model }}\{{ model }}UpdateController;
use App\Http\Controllers\Api\{{ model }}\{{ model }}DestroyController;

Resolver::resolveRouteRegistrar()
    ->prefix('v1/{{ table }}')
    ->group(static function (Router $router): void {
        $router->get('index', {{ model }}IndexController::class);
        $router->get('show', {{ model }}ShowController::class);
        $router->post('store', {{ model }}StoreController::class);
        $router->post('update', {{ model }}UpdateController::class);
        $router->post('destroy', {{ model }}DestroyController::class);
    });