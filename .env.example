APP_NAME="Laravel Inertia Stack"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PHP_CLI_SERVER_WORKERS=4

DB_CONNECTION=mysql
DB_DATABASE="laravel_inertia_stack"
DB_USERNAME="root"
DB_PASSWORD=null

REDIS_USERNAME=null
REDIS_PASSWORD=null

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=127.0.0.1

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/owl-alpha"

AI_ENABLED=false
AUTH_TOKEN_LIFETIME_DAYS=30
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
